---
import VideoPlayer from '../React/VideoPlayer';

interface Project {
  title: string;
  description: string; // Nueva propiedad para la descripción del proyecto
  video: string;       // URL de GitHub Releases u otro alojamiento
  poster?: string;     // Opcional: captura estática o poster
  link?: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Tiro Libre",
    description: "Página web con temática del Mundial 2026",
    video: "https://github.com/tu-usuario/mi-portafolio/releases/download/v0.1.0-media/demo-proyecto1.mp4",
    poster: "https://placehold.co/600x400/1a1a1a/ffffff?text=Tiro+Libre",
    link: "https://github.com/tu-usuario/proyecto-1",
    status: "Prototipo",
  },
  {
    title: "Playball",
    description: "Aplicación móvil sobre baseball hecha en Unity con capacidades de Realidad Aumentada. ",
    video: "https://github.com/tu-usuario/mi-portafolio/releases/download/v0.1.0-media/demo-proyecto2.mp4",
    poster: "https://placehold.co/600x400/1a1a1a/ffffff?text=Aplicacion+Privada",
    status: "En desarrollo",
  },
  {
    title: "GamePlanet",
    description: "Rediseño en Figma de página web e-commerce de GamePlanet",
    video: "https://github.com/JoseME1/Portafolio-Web/releases/download/video1/Demo.GamePlanet.mp4",
    poster: "/DemoGamePlanet.png",
    status: "Rediseño",
  },
  {
    title: "Reconocimientos Wizard",
    description: "Aplicación multiplataforma para la creación e impresión masiva de constancias y reconocimientos.",
    video: "https://github.com/tu-usuario/mi-portafolio/releases/download/v0.1.0-media/demo-proyecto2.mp4",
    poster: "https://placehold.co/600x400/1a1a1a/ffffff?text=Aplicacion+Privada",
    status: "Colaborador",
  }
];
---

<section id="projects" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mi trabajo</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Proyectos</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => {
          const videoOptions = {
            autoplay: false,
            controls: true,
            responsive: true,
            fluid: true,
            poster: project.poster,
            sources: [
              {
                src: project.video,
                type: 'video/mp4'
              }
            ]
          };

          return (
            <div class="group flex flex-col h-full justify-between">
              <div>
                <div class="mb-4">
                  <VideoPlayer options={videoOptions} client:visible />
                </div>

                <div class="px-3">
                  <div class="flex items-center justify-between gap-4 mb-2">
                    <h4 class="text-2xl font-semibold">{project.title}</h4>
                    
                    <div class="flex gap-2 shrink-0">
                      {project.link ? (
                        <a
                          target="_blank"
                          rel="noopener noreferrer"
                          href={project.link}
                          aria-label={`Ver código de ${project.title}`}
                          class="size-12 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2.5 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                            <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                          </svg>
                        </a>
                      ) : (
                        <span
                          title="Código en repositorio privado"
                          class="px-3 py-1.5 text-xs text-[var(--white-icon)] border border-[var(--white-icon-tr)] rounded-lg bg-[#1414149c] flex items-center gap-1.5 select-none h-fit"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                          </svg>
                          Privado
                        </span>
                      )}
                    </div>
                  </div>

                  <span class="inline-block mb-3 text-xs font-medium px-2.5 py-1 rounded-md bg-[var(--white-icon-tr)] text-[var(--sec)] border border-[#ffffff10]">
                    {project.status}
                  </span>

                  <p class="text-sm md:text-base text-[var(--white-icon)] leading-relaxed">
                    {project.description}
                  </p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>